# ─────────────────────────────────────────────────────────────
# Umbral — variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# .env.local NUNCA se sube al repositorio (ver .gitignore).
# Ver SETUP.md para el paso a paso de cómo crear cada cuenta gratis.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas (free tier M0) — https://www.mongodb.com/cloud/atlas/register
# Database > Connect > Drivers > copiá el connection string y reemplazá <password>
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/umbral?retryWrites=true&w=majority

# Auth.js — secreto para firmar sesiones (JWT).
# Generalo con: npx auth secret   (o cualquier string aleatorio largo)
AUTH_SECRET=

# URL pública del sitio (usada por Auth.js y para generar links absolutos)
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (free tier, 25GB) — https://cloudinary.com/users/register/free
# Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Proveedor de la plataforma — número de WhatsApp para "Publicá tu inmobiliaria"
NEXT_PUBLIC_PROVIDER_WHATSAPP=5491137796683

# Google OAuth (Auth.js v5 los detecta automáticamente por nombre de variable)
# Consola: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js v5 usa AUTH_URL (NEXTAUTH_URL es el nombre legacy de v4, se puede omitir)
AUTH_URL=http://localhost:3000

# Emails que reciben rol admin automáticamente al iniciar sesión (separados por coma)
ADMIN_EMAILS=ssantii200@gmail.com
