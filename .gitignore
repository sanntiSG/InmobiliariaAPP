# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# netlify
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads locales de desarrollo (storage provider de fallback)
/public/uploads/*
!/public/uploads/.gitkeep

# worker de maplibre-gl, copiado a public/ en cada `npm install` por
# scripts/copy-maplibre-worker.mjs (ver src/lib/map/worker-url.ts) — no se
# versiona, siempre se regenera desde node_modules/maplibre-gl instalado.
/public/maplibre-gl-worker.mjs
/public/maplibre-gl-shared.mjs
